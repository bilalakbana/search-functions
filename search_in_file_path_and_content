ugf() {
    local original_name
    if [[ -n "$TMUX" ]]; then
        original_name=$(tmux display-message -p '#W')  # Save current window name
        tmux rename-window ugf
    fi

    local arg pat patterns
    local GLOB_PATTERN=()
    local EXTRA_OPTS=()
    local IGNORE_OPT=(--ignore-files) # honour .gitignore files (ugrep native, nested ones included); dropped by --no-ignore
    for arg in "$@"; do
        if [[ $arg == --glob=* ]]; then
            patterns=${arg#--glob=}
            while [[ -n $patterns ]]; do
                pat=${patterns%%,*}
                GLOB_PATTERN+=("-g" "$pat")
                [[ $patterns == *,* ]] && patterns=${patterns#*,} || patterns=""
            done
        elif [[ $arg == --exclude=* ]]; then
            patterns=${arg#--exclude=}
            while [[ -n $patterns ]]; do
                pat=${patterns%%,*}
                GLOB_PATTERN+=("-g" "!$pat")
                [[ $patterns == *,* ]] && patterns=${patterns#*,} || patterns=""
            done
        elif [[ $arg == --no-ignore ]]; then
            IGNORE_OPT=()
        else
            EXTRA_OPTS+=("$arg")
        fi
    done

    # Every argument is shell-quoted (%q): fzf runs the command through $SHELL -c.
    # The pattern is '.' (any non-empty line) and the path is '.'; lines come out as file:line:text,
    # so a file name containing ':' cannot be told apart from the line number.
    local UG_CMD
    UG_CMD="GREP_COLORS='fn=35:ln=32:mt=97' $(printf '%q ' ug -rU --color=always --sort=name --line-number --ignore-binary --no-heading "${IGNORE_OPT[@]}" "${GLOB_PATTERN[@]}" "${EXTRA_OPTS[@]}")-e . . | tr -d '\r'"

    FZF_DEFAULT_COMMAND="$UG_CMD" \
    fzf -i --ansi --delimiter : --no-sort --style full --wrap --exact \
        --color 'preview-fg:bright-magenta,fg:252,fg+:252,bg:234,bg+:235,hl:green:underline,hl+:green:underline,info:144,border:240,prompt:161,pointer:161,marker:118,spinner:118,header:168' \
        --preview 'bat --color=always --highlight-line {2} -- {1}' \
        --border top \
        --border-label " $(echo $PWD | sed "s/^[^/]\\+$/\x1b[32m&/" | sed "s/\\(.*\\/\\)\\(.*\\)/\x1b[34m\\1\x1b[32m\\2/" | sed "s/\//\x1b[33m\/\x1b[34m/g") " \
        --preview-window 'up:70%:wrap:+{2}+3/3,~3' \
        --bind "ctrl-r:reload:$UG_CMD || echo 'No results found'" \
        --bind "ctrl-l:toggle-preview" \
        --bind 'home:last,end:first' \
        --bind "alt-up:preview-page-up" \
        --bind "alt-down:preview-page-down" \
        --bind 'enter:execute-silent(nohup xdg-open ./{1})' \
        --bind "ctrl-o:execute-silent(tmux new-window -n nvim  nvim \"\$PWD\"/{1}; tmux select-pane -T editor)" \
        --bind "ctrl-e:execute-silent(~/.SearchFunctions/sub-functions/open_in_file_manager \"\$PWD\"/{1})" \
        --bind "ctrl-c:execute-silent(printf %s {1} | wl-copy)" \
        --bind "ctrl-t:execute-silent(tmux new-window -n infile ~/.SearchFunctions/sub-functions/search_in_single_file \"\$PWD\"/{1}; tmux select-pane -T file-content)" \
        --bind "ctrl-u:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/show_diffs \"\$PWD\"/{1}; tmux select-pane -T git)" \
		--bind "ctrl-g:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/git_diff \"\$PWD\"/{1}; tmux select-pane -T git)" \
		--bind "alt-g:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/git_diff_short \"\$PWD\"/{1}; tmux select-pane -T git)" \
        --bind "alt-j:execute-silent(tmux new-window -n folders ~/.SearchFunctions/sub-functions/folder_list_ugf; tmux select-pane -T folder-list)" \
        --bind "alt-u:execute-silent(tmux new-window -n logs ~/.SearchFunctions/sub-functions/show_logs \"\$PWD\"/{1}; tmux select-pane -T git)" \
        --bind "ctrl-j:execute-silent(tmux new-window -n files ~/.SearchFunctions/sub-functions/file_list; tmux select-pane -T file-list)" \
        --bind "ctrl-alt-h:unix-line-discard" \
        --bind "alt-bs:unix-word-rubout" \
        --bind "ctrl-h:backward-kill-word"

    if [[ -n "$TMUX" ]]; then
        tmux rename-window "$original_name"  # Restore original name
    fi
}
