#!/bin/bash

FILE=$(realpath -- "$1")
QUERY="$2"

[[ -z "$FILE" ]] && { echo "Please provide a file name"; exit 1; }

# fzf runs the preview, bind and reload commands through $SHELL -c; FILE and QUERY reach them via the
# environment, so their contents are never spliced into a command string.
export FILE QUERY

# Look: Catppuccin Macchiato on the terminal's own background, as in sf. The list's matches red, its line
# numbers dim; the preview is bat with the base16 theme (the terminal's Catppuccin colours, the selected
# line in a band; BAT_THEME wins when set).
export GREP_COLORS='ms=1;38;2;237;135;150:mc=1;38;2;237;135;150:sl=:cx=38;2;128;135;162:fn=38;2;138;173;244:ln=38;2;128;135;162:bn=38;2;128;135;162:se=38;2;110;115;141'
export BAT SYNTAX_THEME=${BAT_THEME:-base16}
BAT=$(command -v bat || command -v batcat)
FZF_COLORS='bg:-1,gutter:-1,preview-bg:-1,preview-fg:-1,bg+:#363A4F,fg:#CAD3F5,fg+:#CAD3F5,query:#CAD3F5,hl:#ED8796,hl+:#ED8796,header:#A5ADCB,info:#C6A0F6,prompt:#C6A0F6,pointer:#F4DBD6,marker:#B7BDF8,spinner:#F4DBD6,selected-bg:#494D64,border:#6E738D,label:#CAD3F5'
dim=$'\033[38;2;128;135;162m' faint=$'\033[38;2;110;115;141m' text=$'\033[38;2;202;211;245m' off=$'\033[0m'
dir=${FILE%/*}/ name=${FILE##*/}
label=" $dim${dir//\//$faint/$dim}$text$name$off "
# fzf 0.66+ draws a bar in the gutter of every line; a blank keeps the list calm (older ones draw none)
gutter=()
if printf '%s\n' 0.66.0 "$(fzf --version | cut -d ' ' -f1)" | sort -V -C; then gutter=(--gutter ' '); fi

FZF_DEFAULT_COMMAND='ugrep -Un --color=always --smart-case -e "$QUERY" -- "$FILE" | tr -d "\r"' \
fzf -i --ansi "${gutter[@]}" \
    --with-shell 'bash -c' \
    --no-sort \
    --exact \
    --style full \
    --wrap \
    --border rounded \
    --query "$QUERY" \
    --border-label "$label" \
    --input-label " ${dim}type to search this file · with several words, lines with any of them$off " \
    --delimiter : \
    --preview '
        line={1}; case $line in ""|*[!0-9]*) line=0 ;; esac   # the list line number, nothing else
        if [ -n "$BAT" ]; then
            if [ "$line" -gt 0 ]; then mark=(--highlight-line "$line"); else mark=(); fi
            "$BAT" --color=always --theme="$SYNTAX_THEME" --style=numbers --terminal-width="${FZF_PREVIEW_COLUMNS:-80}" \
                "${mark[@]}" -- "$FILE"
        else
            ugrep -Un -e "" -- "$FILE" | tr -d "\r"
        fi' \
    --color "$FZF_COLORS" \
    --layout reverse \
    --preview-window "down:75%:wrap:+{1}-5" \
    --bind "alt-up:preview-page-up" \
    --bind "alt-down:preview-page-down" \
    --bind 'home:first,end:last' \
    --bind "ctrl-l:toggle-preview" \
    --bind 'enter:execute-silent(nohup xdg-open "$FILE")' \
    --bind 'ctrl-c:execute-silent(printf %s "$FILE" | wl-copy)' \
    --bind 'ctrl-o:execute-silent(tmux new-window -n nvim  nvim "$FILE"; tmux select-pane -T editor)' \
    --bind 'ctrl-e:execute-silent(~/.SearchFunctions/sub-functions/open_in_file_manager "$FILE")' \
    --bind 'ctrl-t:execute-silent(tmux new-window -n infile ~/.SearchFunctions/sub-functions/search_in_single_file "$FILE"; tmux select-pane -T file-content)' \
    --bind 'ctrl-u:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/show_diffs "$FILE"; tmux select-pane -T git)' \
	--bind 'ctrl-g:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/git_diff "$FILE"; tmux select-pane -T git)' \
	--bind 'alt-g:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/git_diff_short "$FILE"; tmux select-pane -T git)' \
    --bind 'alt-u:execute-silent(tmux new-window -n logs ~/.SearchFunctions/sub-functions/show_logs "$FILE"; tmux select-pane -T git)' \
    --bind "ctrl-alt-h:unix-line-discard" \
    --bind "alt-bs:unix-word-rubout" \
    --bind "ctrl-h:backward-kill-word" \
    --bind 'change:reload(
        pattern=$(printf %s {q} | tr " " "|")
        ugrep -Un --color=always --smart-case -e "$pattern" -- "$FILE" | tr -d "\r"
    )' \
    --bind 'ctrl-r:reload(
        pattern=$(printf %s {q} | tr " " "|")
        ugrep -Un --color=always --smart-case -e "$pattern" -- "$FILE" | tr -d "\r"
    )'
