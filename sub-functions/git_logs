logs() { (   # subshell: cd, variables and the helper functions do not leak into the interactive shell
    COLUMNS=$(tput cols)
    HR=$(printf '%*s' "$COLUMNS" '' | tr ' ' '-')
    FORMAT="$HR%n%C(magenta)<%an>%C(reset) %C(green)(%ar)%C(reset) %C(cyan)%ad%C(reset) - %C(yellow)%h%C(reset) %C(white dim)<%ae>%C(reset) %C(red dim)%S%C(reset)%n%C(white)%s%C(reset)%n"
    DATEOPT="--date=format:%Y-%m-%d %H:%M:%S"

    local path_arg=""
    local git_args=()
    local original_dir="$PWD"

    for arg in "$@"; do
        if [[ -z "$path_arg" && -e "$arg" ]]; then
            path_arg=$(readlink -f "$arg")
        else
            git_args+=("$arg")
        fi
