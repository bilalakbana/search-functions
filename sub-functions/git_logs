    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo -e "\033[31mNot inside a Git repository.\033[0m"; return
    fi

    # First pass: count total commits, second pass: number them and show
    total_commits=$(git log --all --oneline "${git_args[@]}" | wc -l)
    git log --all --pretty=format:'%H%x1f%S' "${git_args[@]}" \
    | awk -F$'\x1f' -v total="$total_commits" 'BEGIN{count=0} {count++; print $1 "\x1f" $2 "\x1f" (total-count+1)}' \
    | while IFS=$'\x1f' read -r sha src commit_num || [[ -n "$sha" ]]; do _show_commit "$sha" "$src" "$commit_num"; done \
    | less -R -i --mouse
) }
