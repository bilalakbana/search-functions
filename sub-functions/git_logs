gfzf() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo -e "\033[31mNot inside a Git repository.\033[0m"
        return 1
    fi
    # Optional path filter; the preview reads it from the environment (it is never spliced into the command)
    local -x GFZF_PATH=""
    if [[ -n "$*" && -e "$*" ]]; then
        GFZF_PATH="$*"
    fi

    local -x LESS='-R'
    local -x BAT_PAGER='less -S -R -M -i'
    local total_commits

    # First pass: count total commits for numbering (used in preview)
    total_commits=$(git log --all --oneline "$@" | wc -l)
    
    git log --all \
        --graph --color=always --abbrev=7 \
        --format=format:"%C(bold blue)%h%C(reset) %C(dim white)%an%C(reset)%C(bold yellow)%d%C(reset) %C(white)%s%C(reset) %C(bold green)(%ar)%C(reset)%x1f%H%x1f%S" "$@" | \
        sed -E 's#refs/(heads/|remotes/[^/]+/|tags/)##g' | \
        awk -F$'\x1f' -v total="$total_commits" 'BEGIN{commit_count=0} {
            # Commit lines end with the two hidden fields %H and %S; everything before them is the
            # display text. Reading them from the END keeps the fields right even if a subject or an
            # author name contains the 0x1f delimiter (those pieces are joined back with spaces).
            if (NF >= 3) {
                commit_count++
                sha = $(NF-1)
                branch = $NF
                display = $1
                for (k = 2; k <= NF-2; k++) display = display " " $k
                commit_num = total - commit_count + 1
                # Clean up branch name and check if its not a SHA
                if (length(branch) > 0 && !match(branch, /^[0-9a-f]{7,40}$/)) {
                    # Add commit number at the beginning, branch at the end, and include commit_num in hidden field
                    gsub(/\033\[2;31m/, "", branch)  # Remove any existing color codes
                    gsub(/\033\[0m/, "", branch)
                    print "\033[38;2;171;171;255m" commit_num "\033[0m " display " \033[2;31m" branch "\033[0m" "\x1f" sha "\x1f" branch "\x1f" commit_num
                } else {
                    # Add commit number at the beginning and include commit_num in hidden field
                    print "\033[38;2;171;171;255m" commit_num "\033[0m " display "\x1f" sha "\x1f" branch "\x1f" commit_num
                }
            } else {
                # Print empty/formatting lines as-is (tree structure)
                print $0
            }
        }' | \
        fzf --exact --ansi --no-sort --wrap --layout reverse --tiebreak index \
            --delimiter $'\x1f' --with-nth=1 \
            --preview '
                sha={2}; src={3}; commit_num={4}
                pathspec=(); [[ -n "$GFZF_PATH" ]] && pathspec=(-- "$GFZF_PATH")
                case $sha in ""|*[!0-9a-f]*) exit 0;; esac   # only a hex object name may reach git
                b=$(printf %s "$src" | sed -E "s#refs/(heads/|remotes/[^/]+/|tags/)##")
                
                # Show commit info (author, date, hash, message) with branch and commit number appended to first line
                git show -s --color=always --date=format:"%Y-%m-%d %H:%M:%S" --pretty=format:"%C(magenta)<%an>%C(reset) %C(green)(%ar)%C(reset) %C(cyan)%ad%C(reset) - %C(yellow)%h%C(reset) %C(white dim)<%ae>%C(reset)%n%C(white)%s%C(reset)" --end-of-options "$sha" 2>/dev/null \
                | awk -v branch="$b" -v branch_color="\033[2;31m" -v reset_color="\033[0m" -v commit_num="$commit_num" \
                      "NR==1 && length(branch) && !match(branch, /^[0-9a-f]{7,40}$/) && length(commit_num) {print \$0 \" \" branch_color branch reset_color \" \033[38;2;171;171;255m-> Commit #\" commit_num \"\033[0m\"; next} NR==1 && length(commit_num) {print \$0 \" \033[38;2;171;171;255m-> Commit #\" commit_num \"\033[0m\"; next} NR==1 && length(branch) && !match(branch, /^[0-9a-f]{7,40}$/) {print \$0 \" \" branch_color branch reset_color; next} {print}"
                
                # Show Files and Diffs sections only if there are changes
                if git diff-tree --no-commit-id --name-only -r --root --end-of-options "$sha" "${pathspec[@]}" 2>/dev/null | grep -q .; then
                  echo
                  printf "\033[31mFiles:\033[0m\n"
                  git show --color=always --format= --name-status --end-of-options "$sha" "${pathspec[@]}" 2>/dev/null
                  echo
                  
                  printf "\033[31mDiffs:\033[0m"
                  if command -v delta >/dev/null 2>&1; then
                    git show --color=always --format= --end-of-options "$sha" "${pathspec[@]}" 2>/dev/null | delta --line-numbers
                  else
                    git show --color=always --format= --end-of-options "$sha" "${pathspec[@]}" 2>/dev/null
                  fi
                fi
            ' \
            --border top \
            --border-label " $(echo $PWD | sed "s/^[^/]\\+$/\x1b[32m&/" | sed "s/\\(.*\\/\\)\\(.*\\)/\x1b[34m\\1\x1b[32m\\2/" | sed "s/\//\x1b[33m\/\x1b[34m/g") " \
            --color 'fg:252,fg+:252,bg:234,bg+:235,hl:magenta,hl+:magenta,info:144,border:240,prompt:161,pointer:161,marker:118,spinner:118,header:168' \
            --bind 'ctrl-l:toggle-preview' \
            --bind 'alt-up:preview-page-up' \
            --bind 'alt-down:preview-page-down' \
            --bind 'home:first,end:last' \
            --bind 'ctrl-alt-h:unix-line-discard' \
            --bind 'alt-bs:unix-word-rubout' \
            --bind 'ctrl-h:backward-kill-word' \
            --preview-window up:55%:wrap
}
