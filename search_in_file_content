ugrep-fzf() {
    local original_name
    if [[ -n "$TMUX" ]]; then
        original_name=$(tmux display-message -p '#W')  # Save current window name
        tmux rename-window ugrep
    fi

    local arg pat patterns
    local GLOB_PATTERN=()
    local EXTRA_OPTS=()
    local IGNORE_OPT=(--ignore-files) # honour .gitignore files (ugrep native, nested ones included); dropped by --no-ignore
    for arg in "$@"; do
        if [[ $arg == --glob=* ]]; then
            patterns=${arg#--glob=}
            while [[ -n $patterns ]]; do
                pat=${patterns%%,*}
                GLOB_PATTERN+=("-g" "$pat")
                [[ $patterns == *,* ]] && patterns=${patterns#*,} || patterns=""
            done
        elif [[ $arg == --exclude=* ]]; then
            patterns=${arg#--exclude=}
            while [[ -n $patterns ]]; do
                pat=${patterns%%,*}
                GLOB_PATTERN+=("-g" "!$pat")
                [[ $patterns == *,* ]] && patterns=${patterns#*,} || patterns=""
            done
        elif [[ $arg == --no-ignore ]]; then
            IGNORE_OPT=()
        else
            EXTRA_OPTS+=("$arg")
        fi
    done

    # Every argument is shell-quoted (%q): fzf runs the command through $SHELL -c
    local UG_PREFIX
    UG_PREFIX=$(printf '%q ' ugrep -rU --sort=name --files-with-matches --smart-case --ignore-binary "${IGNORE_OPT[@]}" "${GLOB_PATTERN[@]}" "${EXTRA_OPTS[@]}")
    local COLOR_AND_SORT="stdbuf -oL sed 's/\\(.*\\/\\)\\(.*\\)/\x1b[34m\\1\x1b[32m\\2/' | stdbuf -oL sed 's/\//\x1b[33m\/\x1b[34m/g' | stdbuf -oL sed 's/^[^/]\\+$/\x1b[32m&/'"

    FZF_DEFAULT_COMMAND="$UG_PREFIX -e '' . | $COLOR_AND_SORT" \
    fzf -i --ansi --no-sort --style full --wrap --delimiter : \
        --preview 'printf "\033[31mFile Path :\033[0m " && printf "%s\n" {} | sed "s/^[^/]\\+$/\x1b[32m&/" | sed "s/\\(.*\\/\\)\\(.*\\)/\x1b[34m\\1\x1b[32m\\2/" | sed "s/\//\x1b[33m\/\x1b[34m/g";if [[ ! -z {q} ]]; then printf "\033[31mMatches   :\033[31m ";ugrep -o --smart-case -U -e {q} -- {} 2>/dev/null | wc -l;echo;GREP_COLORS="ln=32:sl=35:cx=35:mt=1;31:fn=32" ugrep --smart-case -U --color=always -n -C 8 -e {q} -- {} | tr -d "\r";else printf "\033[31mMatches   :\033[31m \n\n";ugrep -U --color=always -n --colors=ln=32,sl=35,ms=35,mc=35 -e "" -- {} | tr -d "\r";fi' \
        --color 'preview-fg:bright-magenta,fg:252,fg+:252,bg:234,bg+:235,hl:magenta,hl+:magenta,info:144,border:240,prompt:161,pointer:161,marker:118,spinner:118,header:168' \
        --disabled -q "" \
        --border top \
        --border-label " $(echo $PWD | sed "s/^[^/]\\+$/\x1b[32m&/" | sed "s/\\(.*\\/\\)\\(.*\\)/\x1b[34m\\1\x1b[32m\\2/" | sed "s/\//\x1b[33m\/\x1b[34m/g") " \
        --bind "change:reload:$UG_PREFIX -e {q} . | $COLOR_AND_SORT" \
        --bind "ctrl-r:reload:$UG_PREFIX -e {q} . | $COLOR_AND_SORT" \
        --bind "ctrl-l:toggle-preview" \
        --bind 'home:last,end:first' \
        --bind "alt-up:preview-page-up" \
        --bind "alt-down:preview-page-down" \
        --bind 'enter:execute-silent(~/.SearchFunctions/sub-functions/platform_action open ./{})' \
        --bind "ctrl-o:execute([[ -z {q} ]] && tmux new-window -n nvim nvim \"\$PWD\"/{} || tmux new-window -n nvim nvim \"\$PWD\"/{} -c /{q} -c \"set hlsearch\"; tmux select-pane -T editor)" \
        --bind "ctrl-e:execute-silent(~/.SearchFunctions/sub-functions/platform_action reveal \"\$PWD\"/{})" \
        --bind "ctrl-c:execute-silent(~/.SearchFunctions/sub-functions/platform_action copy-path {})" \
        --bind "ctrl-t:execute-silent(tmux new-window -n infile ~/.SearchFunctions/sub-functions/search_in_single_file \"\$PWD\"/{} {q}; tmux select-pane -T file-content)" \
        --bind "ctrl-u:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/show_diffs \"\$PWD\"/{}; tmux select-pane -T git)" \
		--bind "ctrl-g:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/git_diff \"\$PWD\"/{}; tmux select-pane -T git)" \
		--bind "alt-g:execute-silent(tmux new-window -n diff ~/.SearchFunctions/sub-functions/git_diff_short \"\$PWD\"/{}; tmux select-pane -T git)" \
        --bind "alt-j:execute-silent(tmux new-window -n folders ~/.SearchFunctions/sub-functions/folder_list_ugrep; tmux select-pane -T folder-list)" \
        --bind "alt-u:execute-silent(tmux new-window -n logs ~/.SearchFunctions/sub-functions/show_logs \"\$PWD\"/{}; tmux select-pane -T git)" \
        --bind "ctrl-j:execute-silent(tmux new-window -n files ~/.SearchFunctions/sub-functions/file_list; tmux select-pane -T file-list)" \
        --bind "ctrl-alt-h:unix-line-discard" \
        --bind "alt-bs:unix-word-rubout" \
        --bind "ctrl-h:backward-kill-word" \
        --preview-window "up:70%:wrap"

    if [[ -n "$TMUX" ]]; then
        tmux rename-window "$original_name"  # Restore original name
    fi
}
